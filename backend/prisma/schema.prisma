generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  STAFF
  DEPARTMENT_MANAGER
  ADMIN
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT

  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED

  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED

  DEPARTMENT_CREATED
  COURSE_CREATED
}

enum DepartmentType {
  ACADEMIC
  ADMINISTRATIVE
  TECHNICAL
  SUPPORT
}

enum RecordStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum RecordPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Semester {
  FALL
  SPRING
  SUMMER
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  isActive     Boolean  @default(true)

  refreshTokenHash String?
  lastLoginAt      DateTime?

  resetPasswordToken     String?   @unique
  resetPasswordExpiresAt DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdRecords  Record[] @relation("CreatedRecords")
  assignedRecords Record[] @relation("AssignedRecords")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          String         @id @default(cuid())
  name        String         @unique
  code        String         @unique
  type        DepartmentType
  description String?
  isActive    Boolean        @default(true)

  users     User[]
  records   Record[]
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Record {
  id          String         @id @default(cuid())
  title       String
  description String
  status      RecordStatus   @default(OPEN)
  priority    RecordPriority @default(MEDIUM)
  resolution  String?

  createdById String
  createdBy   User   @relation("CreatedRecords", fields: [createdById], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedRecords", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  localCredit Int
  ects        Int
  year        Int
  semester    Semester
  isActive    Boolean  @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entity      String?
  entityId    String?
  performedBy String?
  role        UserRole?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([action])
  @@index([performedBy])
  @@index([createdAt])
}
